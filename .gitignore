# ============================================================
# Learning Agent — Git ignore policy
# Rule of thumb: commit protocols, schemas, specs, prompts, code
# and reviewed benchmark results. Never commit secrets, generated
# run output, or production Vault data.
# ============================================================

# --- Secrets (never commit) ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
service-account*.json

# --- Generated experiment output -----------------------------
# Runs are reproducible artifacts, not source. Promote reviewed
# results into benchmark/results/ instead.
runs/*
!runs/README.md
!runs/.gitignore

# --- Python --------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / TypeScript --------------------------------------
node_modules/
dist/*
!dist/learning-knowledge-growth.skill.zip
build/
*.tsbuildinfo
coverage/
# npm cache redirected into the repo by .npmrc (see that file for why).
.npm-cache/

# Codex-provided remote attachments are task-local inputs, not project files.
.codex-remote-attachments/
.eslintcache

# --- Obsidian plugin build output ----------------------------
obsidian-plugin/main.js
obsidian-plugin/styles.css

# --- Test vault ---------------------------------------------
# The test vault is disposable sandbox data and must never be
# confused with the user's production Vault. Only the machine
# layer metadata that defines the sandbox is tracked.
test-vault/*
!test-vault/README.md
!test-vault/.learning-agent
!test-vault/.gitkeep

# --- Temporary personal pilot vault --------------------------
# Real classroom notes and pilot manifests are local-only and must never be
# committed with the repository.
pilot-vault/*

# --- OS / editor noise ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Local scratch -------------------------------------------
tmp/
scratch/
workspace/*
!workspace/README.md
ynuagent.pdf
*.local

# --- Personal experiment configurations ----------------------
# Keep portable examples such as course-profiles.json, but do not publish
# case files containing machine-specific Vault and transcript paths.
configs/COURSE_REBUILD_*.json
configs/PRESENTATION_*.json
configs/PILOT_*.json
configs/real-case-*.json
configs/course-profiles.json
configs/cloud-rebuild-v0.1.json
configs/jev-teamorouter.json
feed-*.cmd
open-learning-agent-ui.cmd
run-learning-inbox.cmd
run-learning-session.cmd
tools/learning-agent-ui.ps1
tools/run-learning-inbox.ps1
tools/run-learning-session.ps1
tools/run-dsh-low-model.ps1
