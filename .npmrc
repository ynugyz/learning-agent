# Local npm configuration for this repository.
#
# `cache` is redirected into the repository on purpose.
#
# Reason: on the M1A-V host the default npm cache (%LOCALAPPDATA%\npm-cache) is
# outside the writable workspace, and npm fails with EPERM when it tries to
# write there. `.npm-cache/` is git-ignored, so nothing from it is ever
# committed. This is a host workaround, not a project convention: a machine
# with a writable global cache does not need it, and removing this file only
# costs a re-download.
#
# `registry` is pinned to the default public registry so the resolved dependency
# URLs in package-lock.json stay reproducible.
registry=https://registry.npmjs.org/
cache=.npm-cache
audit=false
fund=false
