# ============================================================
# Learning Agent — environment variable template
#
# Copy to `.env` and fill in real values locally.
# `.env` is git-ignored and must NEVER be committed.
#
# This file documents required variable NAMES and non-secret
# defaults only. It must never contain a real credential.
# ============================================================

# --- Model / provider access (secrets: leave empty here) -----
# API key for the model provider used by the agent runtime.
LEARNING_AGENT_API_KEY=""
# Base URL for an OpenAI-compatible endpoint, if not the default.
LEARNING_AGENT_BASE_URL=
# Model identifier used for experiments. Recorded in run manifests.
LEARNING_AGENT_MODEL=

# Optional TypeSafe/Jev decision adapter (never commit a real key).
# TeamoRouter is the supported local relay for the current experiment.
TEAMOROUTER_API_KEY=""
TEAMOROUTER_BASE_URL=https://api.teamorouter.cn/v1/systemone
TEAMOROUTER_MODEL=jev
# Direct TypeSafe names remain supported for a future direct endpoint.
TYPESAFE_API_KEY=""
TYPESAFE_MODEL=jev-1.13.0

# --- Agent runtime -------------------------------------------
# Which runtime adapter the pipeline loads. Only `dsh` is planned
# for the current milestone; core modules must stay runtime-agnostic.
LEARNING_AGENT_RUNTIME=dsh
# Optional explicit path to a DSH checkout/install. Informational:
# the adapter detects the installed DSH, it does not install one.
DSH_PATH=
# DSH home directory (already provided by the DSH runtime itself).
# DSH_HOME=C:\Users\<user>\.dsh

# --- Paths ---------------------------------------------------
# Path to the sandbox vault used by experiments.
# MUST point at ./test-vault during M0. NEVER at a production Vault.
LEARNING_AGENT_TEST_VAULT=./test-vault

# --- Observability / logs ------------------------------------
# Directory for generated run artifacts. Git-ignored.
LEARNING_AGENT_RUNS_DIR=./runs
# Log verbosity: debug | info | warn | error
LEARNING_AGENT_LOG_LEVEL=info
